{
  "name": "@kyndro/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "mock:prism": "pnpm dlx @stoplight/prism-cli@5.11.2 mock ../contract/openapi.yaml -p 4010",
    "msw:init": "msw init public/ --save"
  },
  "dependencies": {
    "@kyndro/design-system": "workspace:*",
    "@kyndro/types": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0",
    "jsdom": "^25.0.0",
    "msw": "^2.6.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}