# Kyndro — dev environment variable NAMES only. No values here, ever
# (PLAN.md §6: never store secrets in code). Copy to a local, gitignored
# .env and fill in real values yourself; see HUMAN-SETUP.md §3 for what
# each secret is and where to set it for real (repo secrets), not here.

# --- App / build ---
VITE_API_MODE=mock
VITE_API_BASE_URL=

# --- Telemetry (ADR-012) ---
# In dev, leave unset or point at a local file, e.g. file:./tmp/telemetry-dev.ndjson
ERROR_TRACKING_DSN=

# --- GitHub App (W2, placeholders until then) ---
KYNDRO_GITHUB_APP_ID=
KYNDRO_GITHUB_APP_PRIVATE_KEY=
KYNDRO_GITHUB_WEBHOOK_SECRET=

# --- Data (W2) ---
DATABASE_URL=

# --- Waitlist storage (W1-SYS-2 / ADR-010) ---
# v1 uses a local JSON file; this name is reserved for the future real backend.
WAITLIST_STORAGE_KEY=
