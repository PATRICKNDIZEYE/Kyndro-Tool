# Kyndro — staging environment variable NAMES only. No values here, ever
# (PLAN.md §6: never store secrets in code). Real values live in GitHub
# Actions / hosting-provider secrets, set by a human per HUMAN-SETUP.md §3.

# --- App / build ---
VITE_API_MODE=live
VITE_API_BASE_URL=

# --- Telemetry (ADR-012) ---
# Once a real vendor is chosen and accepted, this becomes that vendor's DSN.
# Until then, a file: URL keeps using the local transport in staging too.
ERROR_TRACKING_DSN=

# --- GitHub App (W2) ---
KYNDRO_GITHUB_APP_ID=
KYNDRO_GITHUB_APP_PRIVATE_KEY=
KYNDRO_GITHUB_WEBHOOK_SECRET=

# --- Data (W2) ---
DATABASE_URL=

# --- Waitlist storage (W1-SYS-2 / ADR-010) ---
WAITLIST_STORAGE_KEY=
